<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/bg_primary" />
            <stroke
                android:width="1dp"
                android:color="@color/shadow_dark" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/bg_primary" />
            <stroke
                android:width="1dp"
                android:color="@color/shadow_light" />
        </shape>
    </item>
</layer-list>